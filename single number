class Solution(object):
    def singleNumber(self, nums):
        """
        :type nums: List[int]
        :rtype: List[int]
        """
        result = 0

        for num in nums:
            result ^= num

        diff = result & -result

        a = 0
        b = 0

        for num in nums:
            if num & diff:
                a ^= num
            else:
                b ^= num

        return [a, b]
